# Configuracao da IA do Albert (backend). Copie este arquivo como .env e preencha a chave
# O server/.env e ignorado pelo git (.gitignore): a chave NUNCA vai pro repositorio.

# Fornecedor da IA: gemini
IA_PROVIDER=gemini

# Modelo do Gemini (free tier do Google AI Studio)
GEMINI_MODEL=gemini-flash-lite-latest

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Alternativa: Claude (precisa de chave + credito) ---
# IA_PROVIDER=claude
# CLAUDE_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
